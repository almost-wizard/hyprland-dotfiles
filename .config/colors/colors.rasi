* {
    primary: #780800;
    primary-fixed: #e41800;
    primary-fixed-dim: #b61100;
    on-primary: #ffffff;
    on-primary-fixed: #ffffff;
    on-primary-fixed-variant: #ffffff;
    primary-container: #e41800;
    on-primary-container: #ffffff;
    secondary: #780800;
    secondary-fixed: #ce422d;
    secondary-fixed-dim: #ab2917;
    on-secondary: #ffffff;
    on-secondary-fixed: #ffffff;
    on-secondary-fixed-variant: #ffffff;
    secondary-container: #ce422d;
    on-secondary-container: #ffffff;
    tertiary: #003a71;
    tertiary-fixed: #0073d8;
    tertiary-fixed-dim: #005aac;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #ffffff;
    on-tertiary-fixed-variant: #ffffff;
    tertiary-container: #0073d8;
    on-tertiary-container: #ffffff;
    error: #7b0007;
    on-error: #ffffff;
    error-container: #d8332d;
    on-error-container: #ffffff;
    surface: #fff8f6;
    on-surface: #25130f;
    on-surface-variant: #50322d;
    outline: #6f4e48;
    outline-variant: #8f6a64;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #412b27;
    inverse-on-surface: #ffedea;
    inverse-primary: #ffb4a7;
    surface-dim: #e4c1ba;
    surface-bright: #fff8f6;
    surface-container-lowest: #ffffff;
    surface-container-low: #fff0ee;
    surface-container: #ffe2dd;
    surface-container-high: #fad6cf;
    surface-container-highest: #efcbc5;
}
